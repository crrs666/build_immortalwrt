#!/bin/sh /etc/rc.common
#
# AP-DK07.1-C1 风扇控制（本地实现，不依赖云端）
#
# 对应原厂 /etc/init.d/box_led_sound 中 export pwm2 / 启动 fan_ctl 的部分，
# 但不再启动 iot_interact、box_led_sound 等依赖云端/AI 板的进程。
# 停止服务只结束守护进程，内核 PWM 继续输出，风扇保持最后转速（避免停转过热）。

START=95
USE_PROCD=1

start_service() {
	config_load fanctl
	config_get_bool enabled settings enabled 1
	[ "$enabled" = "1" ] || return 0

	procd_open_instance
	procd_set_param command /usr/sbin/fanctl run
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}