#!/bin/sh /etc/rc.common
#
# AP-DK07.1-C1: 点亮 RJ45 网口指示灯（5 个 QCA8075 PHY 的 LED）
#
# 这 5 个 LED 属于 PHY，由 qca807x 驱动注册成 LED class 设备，名字形如
#   <mdio 控制器名>:<phy 地址>:<dts label>
# 即 90000.mdio-1:00:lan1 … :03:lan4 / :04:wan（内核对 PHY LED 强制带
# devicename 前缀，所以不是裸的 lan1）。
#
# 内核不会自动给它们挂 trigger，而 qca807x 只在 LED 被 netdev trigger 接管
# （走 LED_HW_CTRL offload，驱动才去写 MMD7 的 LED 控制寄存器）之后灯才会
# 亮，所以必须在用户态挂上 trigger。
#
# 内核 6.12 的 netdev trigger 没有合并的 mode 属性，而是一堆独立的开关
# （link / link_10 / link_100 / link_1000 / tx / rx ...），逐个写 1 即可。
# 两个坑（均在真机实测确认）：
#  1) link 与 link_10/100/1000 互斥：先写 link 再写速度位会被 -EINVAL 拒掉
#     （见 ledtrig-netdev.c netdev_led_attr_store() 的互斥检查）；
#  2) qca807x 的 qca807x_led_parse_netdev() 根本不解析 TRIGGER_NETDEV_LINK，
#     它只认 TX / RX / LINK_10 / LINK_100 / LINK_1000 / HALF_DUPLEX /
#     FULL_DUPLEX，所以写 link 是"写进去了但硬件无反应"。
# 正确挂法：按速率点亮 link_10/link_100/link_1000 + 收发闪烁 tx/rx，
# 千万不要碰 link，否则速度位全被拒，灯只剩"有流量才闪"。
#
# 前缀随设备树节点名变化，这里用 *:lan1 通配匹配，不写死前缀。

START=97

set_led() {
	local port="$1" led="$2" mode

	[ -e "$led/trigger" ] || return 0

	echo netdev > "$led/trigger"
	echo "$port" > "$led/device_name"

	for mode in link_10 link_100 link_1000 tx rx; do
		[ -e "$led/$mode" ] && echo 1 > "$led/$mode"
	done
}

start() {
	local led

	for led in /sys/class/leds/*:lan1; do set_led lan1 "$led"; done
	for led in /sys/class/leds/*:lan2; do set_led lan2 "$led"; done
	for led in /sys/class/leds/*:lan3; do set_led lan3 "$led"; done
	for led in /sys/class/leds/*:lan4; do set_led lan4 "$led"; done
	for led in /sys/class/leds/*:wan; do set_led wan "$led"; done
}