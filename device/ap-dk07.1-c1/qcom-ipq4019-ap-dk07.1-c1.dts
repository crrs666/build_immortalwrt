// SPDX-License-Identifier: GPL-2.0-or-later OR MIT
//
// Qualcomm AP-DK07.1-C1 (IPQ4019, 1GB RAM, 256MB NAND)
// Overlay on top of the mainline DK07.1-C1 device tree, based on the
// QCA SDK vendor device tree extracted from the running unit.

#include "qcom-ipq4019-ap.dk07.1-c1.dts"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/soc/qcom,tcsr.h>

/ {
	model = "Qualcomm Technologies, Inc. AP-DK07.1-C1";
	compatible = "qcom,ap-dk07.1-c1", "qcom,ipq4019-ap-dk07.1-c1", "qcom,ipq4019";

	memory {
		reg = <0x80000000 0x40000000>; /* 1GB, mainline assumes 512MB */
	};

	soc {
		/*
		 * PCIe is not populated on this unit and the mainline
		 * perst-gpios (GPIO38) conflict with the vendor
		 * func_reset_gpio (GPIO38).
		 */
		pci@40000000 {
			status = "disabled";
		};

		tcsr@1949000 {
			compatible = "qcom,tcsr";
			reg = <0x1949000 0x100>;
			qcom,wifi_glb_cfg = <TCSR_WIFI_GLB_CFG>;
		};

		tcsr@194b000 {
			/* select hostmode */
			compatible = "qcom,tcsr";
			reg = <0x194b000 0x100>;
			qcom,usb-hsphy-mode-select = <TCSR_USB_HSPHY_HOST_MODE>;
			status = "okay";
		};

		ess_tcsr@1953000 {
			compatible = "qcom,tcsr";
			reg = <0x1953000 0x1000>;
			qcom,ess-interface-select = <TCSR_ESS_PSGMII>;
		};

		tcsr@1957000 {
			compatible = "qcom,tcsr";
			reg = <0x1957000 0x100>;
			qcom,wifi_noc_memtype_m0_m2 = <TCSR_WIFI_NOC_MEMTYPE_M0_M2>;
		};

		/* second UART enabled by mainline dk07.1-c1, unused by vendor */
		serial@78b0000 {
			status = "disabled";
		};

		i2c@78b8000 {
			pinctrl-0 = <&i2c_1_pins>;
			pinctrl-names = "default";
			status = "okay";

			rx8010@32 {
				compatible = "epson,rx8010";
				reg = <0x32>;
			};
		};

		keys {
			compatible = "gpio-keys";

			qconfig {
				label = "qconfig";
				gpios = <&tlmm 18 GPIO_ACTIVE_LOW>;
				linux,code = <0x211>; /* vendor keycode */
			};

			wps-reset {
				label = "wps-reset";
				gpios = <&tlmm 46 GPIO_ACTIVE_LOW>;
				linux,code = <0x198>; /* vendor keycode (KEY_WPS_BUTTON) */
			};

			func {
				label = "func";
				gpios = <&tlmm 54 GPIO_ACTIVE_LOW>;
				linux,code = <0x224>; /* vendor keycode */
			};
		};
	};

	/*
	 * 风扇调速。原厂用 SoC audio PWM 驱动 gpio32(audio_pwm2)，
	 * 主线 ipq4019 没有 PWM 驱动，这里用 pwm-gpio 在同一引脚上做软件 PWM，
	 * 由 /usr/sbin/fanctl 写 /sys/class/pwm/.../duty_cycle 控制转速。
	 * pinctrl 默认 output-high：fanctl 起不来时风扇全速，避免过热。
	 */
	fan_pwm: fan-pwm {
		compatible = "pwm-gpio";
		#pwm-cells = <3>;
		pinctrl-names = "default";
		pinctrl-0 = <&fan_pwm_pins>;
		gpios = <&tlmm 32 GPIO_ACTIVE_HIGH>;
	};
};

&tlmm {
	fan_pwm_pins: fan-pwm-pinmux {
		pins = "gpio32";
		function = "gpio";
		drive-strength = <8>;
		bias-disable;
		output-high;
	};

	i2c_1_pins: i2c-1-pinmux {
		pins = "gpio34", "gpio35";
		function = "blsp_i2c1";
		bias-disable;
	};

	mdio_pins: mdio-pinmux {
		mdio {
			pins = "gpio6";
			function = "mdio";
			bias-pull-up;
		};

		mdc {
			pins = "gpio7";
			function = "mdc";
			bias-pull-up;
		};
	};
};

/*
 * NAND partition layout must match the QCA vendor layout / U-Boot.
 *
 * The partitions node has to live inside the controller's NAND chip
 * child node (nand@0, declared in qcom-ipq4019.dtsi). qcom_nandc walks
 * every available child of the controller and reads its "reg" as the
 * chip-select; a bare "partitions" child has no reg, which aborts the
 * whole controller probe with "can't get chip-select" and leaves the
 * system without any MTD device.
 */
&nand {
	nand@0 {
		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "0:SBL1";
				reg = <0x0 0x40000>;
				read-only;
			};

			partition@40000 {
				label = "0:MIBIB";
				reg = <0x40000 0x40000>;
				read-only;
			};

			partition@80000 {
				label = "0:BOOTCONFIG";
				reg = <0x80000 0x40000>;
				read-only;
			};

			partition@c0000 {
				label = "0:BOOTCONFIG1";
				reg = <0xc0000 0x40000>;
				read-only;
			};

			partition@100000 {
				label = "0:QSEE_1";
				reg = <0x100000 0x80000>;
				read-only;
			};

			partition@180000 {
				label = "0:QSEE";
				reg = <0x180000 0x80000>;
				read-only;
			};

			partition@200000 {
				label = "0:CDT_1";
				reg = <0x200000 0x40000>;
				read-only;
			};

			partition@240000 {
				label = "0:CDT";
				reg = <0x240000 0x40000>;
				read-only;
			};

			/*
			 * U-Boot 环境区。上游 DTS 把它标成 read-only，于是内核
			 * （mtd_flags=0x0）拒绝以可写方式打开 /dev/mtd8，fw_setenv
			 * 直接报 Permission denied —— 改 bootcmd 必须先摘掉这个
			 * 标记。节点本身是 0600 root:root，权限仍由 root 控制。
			 */
			partition@280000 {
				label = "0:APPSBLENV";
				reg = <0x280000 0x40000>;
			};

			partition@2c0000 {
				label = "0:ART";
				reg = <0x2c0000 0x40000>;
				read-only;
			};

			partition@300000 {
				label = "0:APPSBL_1";
				reg = <0x300000 0x100000>;
				read-only;
			};

			partition@400000 {
				label = "0:APPSBL";
				reg = <0x400000 0x100000>;
				read-only;
			};

			/* inactive rootfs slot, kept for recovery */
			partition@500000 {
				label = "rootfs_1";
				reg = <0x500000 0x5b00000>;
			};

			/*
			 * UBI 容器：把厂商 rootfs 槽 (0x6000000) 与其后面的 data 槽
			 * (0xbb00000) 合并成一个 159MB 分区。起点必须保持 0x6000000，
			 * 因为 U-Boot 的 bootipq 是 ubi part fs + ubi read kernel 取内核，
			 * 起点变了就找不到 kernel 卷。合并后 rootfs_data 由 63MB 涨到
			 * 约 150MB；厂商放在 data 里的 overlay 会被丢弃。
			 */
			partition@6000000 {
				label = "rootfs";
				reg = <0x6000000 0x9f00000>;
			};

			partition@ff00000 {
				label = "config_user";
				reg = <0xff00000 0x100000>;

				/*
				 * 出厂 MAC 存放处（本机 0x2000 = D0:B6:0A:00:07:8C）。
				 * ART(0:ART) 偏移 0 全是 0xFF、U-Boot 环境里也没有 ethaddr，
				 * 这个 cell 是内核能拿到的唯一真实 MAC。
				 */
				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <1>;
					#size-cells = <1>;

					macaddr_config_user: macaddr@2000 {
						reg = <0x2000 0x6>;
					};
				};
			};
		};
	};
};

&blsp_dma {
	status = "okay";
};

&watchdog {
	status = "okay";
};

&prng {
	status = "okay";
};

&crypto {
	status = "okay";
};

&cryptobam {
	status = "okay";
};

/*
 * 内置 5 口交换机。qcom-ipq4019.dtsi 里 gmac / switch / swport1..5 默认全是
 * disabled，不使能则 ipqess 与 qca8k 都不 probe，内核一个以太网接口都不建
 * （只剩 lo 和 phy0-ap0/phy1-ap0），串口里表现为完全没有 eth 或 lan 设备。
 * swport1..4 标签为 lan1..lan4，swport5 标签为 wan，与厂商 bootargs 里
 * switch_wan_bmp=0x20 / switch_lan_bmp=0x1e 的端口划分一致。
 */
&gmac {
	status = "okay";
	/* 真实 MAC 取自 config_user@0x2000，否则 ipqess 会自己造随机地址 */
	nvmem-cells = <&macaddr_config_user>;
	nvmem-cell-names = "mac-address";
};

&switch {
	status = "okay";
};

&swport1 {
	status = "okay";
};

&swport2 {
	status = "okay";
};

&swport3 {
	status = "okay";
};

&swport4 {
	status = "okay";
};

&swport5 {
	status = "okay";
};

/*
 * 交换机 5 个口的 PHY（ethphy0..4）和 PSGMII PHY（psgmiiphy）都挂在
 * mdio 总线下面，mdio 不使能的话端口拿不到 phy-handle。
 *
 * ethphy0..4 是 QCA8075，每个 PHY 有 4 个专用 LED 输出脚（最多驱动 2 颗
 * LED）。主线 qca807x 驱动只有在 PHY 节点下有 "leds" 子节点时才会去写
 * MMD7 的 LED 控制寄存器（0x8074/0x8075 + index*2），没有子节点就完全不
 * 碰这些寄存器 —— 这就是 RJ45 指示灯一直不亮的原因。reg 是 PHY 上的 LED
 * 序号（0/1），若发现点亮的不是想要的灯（如亮成速率灯而不是 link 灯），
 * 把 reg 改成 <1> 即可。
 *
 * 注册出来的 LED 名带 mdio 设备名前缀，即
 * 90000.mdio-1:00:lan1 ... :03:lan4 / :04:wan（前缀是 PHY 的 mdio 设备名，
 * 内核 6.12 的 phy_led 强制要求 devicename = dev_name(&phydev->mdio.dev)）。
 * 驱动只在有 trigger 时才写 LED 寄存器，所以还必须由用户态给这些 LED 挂上
 * netdev trigger —— 由 /etc/init.d/phyleds（S97）在每次启动时完成。
 */
&mdio {
	pinctrl-0 = <&mdio_pins>;
	pinctrl-names = "default";
	status = "okay";

	ethernet-phy-package@0 {
		ethernet-phy@0 {
			leds {
				#address-cells = <1>;
				#size-cells = <0>;

				led@0 {
					reg = <0>;
					label = "lan1";
				};
			};
		};

		ethernet-phy@1 {
			leds {
				#address-cells = <1>;
				#size-cells = <0>;

				led@0 {
					reg = <0>;
					label = "lan2";
				};
			};
		};

		ethernet-phy@2 {
			leds {
				#address-cells = <1>;
				#size-cells = <0>;

				led@0 {
					reg = <0>;
					label = "lan3";
				};
			};
		};

		ethernet-phy@3 {
			leds {
				#address-cells = <1>;
				#size-cells = <0>;

				led@0 {
					reg = <0>;
					label = "lan4";
				};
			};
		};

		ethernet-phy@4 {
			leds {
				#address-cells = <1>;
				#size-cells = <0>;

				led@0 {
					reg = <0>;
					label = "wan";
				};
			};
		};
	};
};

&usb2 {
	status = "okay";
};

&usb2_hs_phy {
	status = "okay";
};

&usb3 {
	status = "okay";
};

&usb3_hs_phy {
	status = "okay";
};

&usb3_ss_phy {
	status = "okay";
};

&wifi0 {
	status = "okay";
};

&wifi1 {
	status = "okay";
};
