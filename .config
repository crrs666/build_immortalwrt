# ImmortalWrt build configuration for Qualcomm AP-DK07.1-C1 (IPQ4019)
# Minimal seed config - expanded by `make defconfig` in CI.

# Target
CONFIG_TARGET_ipq40xx=y
CONFIG_TARGET_ipq40xx_generic=y
CONFIG_TARGET_ipq40xx_generic_DEVICE_qcom_ap-dk07.1-c1=y

# 生成 initramfs 镜像（RAM 启动，TFTP + bootm 救砖用）
CONFIG_TARGET_ROOTFS_INITRAMFS=y

# LuCI web interface
CONFIG_PACKAGE_luci=y

# Epson RX8010 RTC on i2c@78b8000 (gpio34/35)
CONFIG_PACKAGE_kmod-rtc-rx8010=y
